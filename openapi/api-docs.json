  "components": {
    "schemas": {
      "Rol": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único del rol",
            "format": "int64",
            "readOnly": true,
            "example": 1
          },
          "nombre": {
            "type": "string",
            "description": "Nombre del rol",
            "example": "ROLE_ADMIN"
          }
        },
        "description": "Rol de autorización dentro del sistema"
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único del usuario",
            "format": "int64",
            "readOnly": true,
            "example": 1
          },
          "username": {
            "type": "string",
            "description": "Nombre de usuario único para autenticación",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "description": "Contraseña del usuario (solo escritura, no se retorna en respuestas)",
            "writeOnly": true,
            "example": "admin123"
          },
          "roles": {
            "uniqueItems": true,
            "type": "array",
            "description": "Roles asignados al usuario",
            "items": {
              "$ref": "#/components/schemas/Rol"
            }
          }
        },
        "description": "Usuario del sistema con sus roles asociados (cliente, cajero, administrador)"
      },
      "Categoria": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único de la categoría",
            "format": "int64",
            "readOnly": true,
            "example": 1
          },
          "nombre": {
            "type": "string",
            "description": "Nombre único de la categoría",
            "example": "Bebidas"
          }
        },
        "description": "Categoría para clasificar los productos del minimarket"
      },
      "Producto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único del producto",
            "format": "int64",
            "readOnly": true,
            "example": 1
          },
          "nombre": {
            "type": "string",
            "description": "Nombre comercial del producto",
            "example": "Coca-Cola 1.5L"
          },
          "precio": {
            "type": "number",
            "description": "Precio unitario en pesos chilenos",
            "format": "double",
            "example": 1890
          },
          "stock": {
            "type": "integer",
            "description": "Unidades disponibles en bodega",
            "format": "int32",
            "example": 24
          },
          "categoria": {
            "$ref": "#/components/schemas/Categoria"
          }
        },
        "description": "Producto del catálogo del minimarket"
      },
      "Inventario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único del movimiento",
            "format": "int64",
            "readOnly": true,
            "example": 1
          },
          "producto": {
            "$ref": "#/components/schemas/Producto"
          },
          "cantidad": {
            "type": "integer",
            "description": "Cantidad de unidades del movimiento",
            "format": "int32",
            "example": 10
          },
          "tipoMovimiento": {
            "type": "string",
            "description": "Tipo de movimiento de inventario",
            "example": "Entrada",
            "enum": [
              "Entrada",
              "Salida"
            ]
          },
          "fechaMovimiento": {
            "type": "string",
            "description": "Fecha y hora del movimiento",
            "format": "date-time",
            "example": "2026-07-05T10:00:00Z"
          }
        },
        "description": "Movimiento de inventario (entrada o salida) de un producto"
      },
      "DetalleVenta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único del detalle",
            "format": "int64",
            "readOnly": true,
            "example": 1
          },
          "venta": {
            "$ref": "#/components/schemas/Venta"
          },
          "producto": {
            "$ref": "#/components/schemas/Producto"
          },
          "cantidad": {
            "type": "integer",
            "description": "Cantidad de unidades vendidas",
            "format": "int32",
            "example": 2
          },
          "precio": {
            "type": "number",
            "description": "Precio unitario aplicado en la venta",
            "format": "double",
            "example": 1890
          }
        },
        "description": "Línea de detalle de una venta: producto, cantidad y precio al momento de la venta"
      },
      "Venta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único de la venta",
            "format": "int64",
            "readOnly": true,
            "example": 1
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          },
          "fecha": {
            "type": "string",
            "description": "Fecha y hora de la venta",
            "format": "date-time",
            "example": "2026-07-05T14:30:00Z"
          }
        },
        "description": "Venta realizada en el minimarket, con su usuario, fecha y detalles"
      },
      "Carrito": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único del ítem del carrito",
            "format": "int64",
            "readOnly": true,
            "example": 1
          },
          "usuario": {
            "$ref": "#/components/schemas/Usuario"
          },
          "producto": {
            "$ref": "#/components/schemas/Producto"
          },
          "cantidad": {
            "type": "integer",
            "description": "Cantidad de unidades del producto",
            "format": "int32",
            "example": 3
          }
        },
        "description": "Ítem del carrito de compras: asocia un producto y su cantidad a un usuario"
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "description": "Autenticación HTTP Basic contra los usuarios registrados en H2",
        "name": "basicAuth",
        "scheme": "basic"
      }
    }
  }
}
{
  "openapi": "3.0.1",
  "info": {
    "title": "Minimarket Plus API",
    "description": "API REST del sistema backend Minimarket Plus. Gestiona productos, categorías, carritos, inventario, ventas y usuarios con roles (cliente, cajero, administrador). Todos los endpoints de negocio requieren autenticación HTTP Basic; use el botón Authorize (credenciales de demostración en el README).",
    "contact": {
      "name": "Equipo Minimarket Plus - PBY2202",
      "email": "karla.santigut@gmail.com"
    },
    "license": {
      "name": "Uso académico - Duoc UC"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Entorno local de desarrollo"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "Carritos",
      "description": "Gestión de los ítems del carrito de compras de los usuarios"
    },
    {
      "name": "Público",
      "description": "Endpoints de acceso público, sin autenticación"
    },
    {
      "name": "Categorías",
      "description": "Gestión de las categorías de productos del minimarket"
    },
    {
      "name": "Inventario",
      "description": "Registro de movimientos de inventario (entradas y salidas) por producto"
    },
    {
      "name": "Productos",
      "description": "Gestión del catálogo de productos del minimarket"
    },
    {
      "name": "Usuarios",
      "description": "Gestión de usuarios y sus roles (cliente, cajero, administrador). La contraseña nunca se retorna en las respuestas."
    },
    {
      "name": "Detalles de venta",
      "description": "Gestión de las líneas de detalle de cada venta (producto, cantidad y precio)"
    },
    {
      "name": "Ventas",
      "description": "Registro y consulta de ventas del minimarket. Los detalles de cada venta se gestionan en /api/detalle-ventas."
    }
  ],
  "paths": {
    "/api/usuarios/{id}": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Obtener un usuario por ID",
        "description": "Busca un usuario específico por su identificador único.",
        "operationId": "obtenerUsuarioPorId",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único del usuario",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "404": {
            "description": "No existe un usuario con el ID indicado"
          },
          "200": {
            "description": "Usuario encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado"
          }
        }
      },
      "put": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Actualizar un usuario existente",
        "description": "Reemplaza los datos del usuario identificado por el ID.",
        "operationId": "actualizarUsuario",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único del usuario a actualizar",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "description": "Nuevos datos del usuario",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Usuario"
              },
              "examples": {
                "usuarioActualizado": {
                  "description": "usuarioActualizado",
                  "value": {
                    "username": "cliente2",
                    "password": "clave-segura-123",
                    "roles": [
                      {
                        "id": 3
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "No existe un usuario con el ID indicado"
          },
          "401": {
            "description": "No autenticado"
          },
          "200": {
            "description": "Usuario actualizado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Eliminar un usuario",
        "description": "Elimina el usuario identificado por el ID.",
        "operationId": "eliminarUsuario",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador único del usuario a eliminar",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "404": {
            "description": "No existe un usuario con el ID indicado"
          },
          "401": {
            "description": "No autenticado"
          },
          "204": {
            "description": "Usuario eliminado correctamente"
          }
        }
      }
    },

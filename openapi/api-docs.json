    "/api/ventas": {
      "get": {
        "tags": [
          "Ventas"
        ],
        "summary": "Listar todas las ventas",
        "description": "Retorna todas las ventas registradas con su usuario, fecha y detalles.",
        "operationId": "listarVentas",
        "responses": {
          "401": {
            "description": "No autenticado"
          },
          "200": {
            "description": "Listado obtenido correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Venta"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Ventas"
        ],
        "summary": "Registrar una nueva venta",
        "description": "Crea la cabecera de una venta (usuario y fecha). Las líneas se agregan luego en /api/detalle-ventas.",
        "operationId": "guardarVenta",
        "requestBody": {
          "description": "Datos de la venta a registrar (el usuario debe existir)",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Venta"
              },
              "examples": {
                "nuevaVenta": {
                  "description": "nuevaVenta",
                  "value": {
                    "usuario": {
                      "id": 2
                    },
                    "fecha": "2026-07-05T14:30:00.000+00:00"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "No autenticado"
          },
          "201": {
            "description": "Venta registrada correctamente",
            "content": {
              "application/json": {

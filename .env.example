# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno requeridas para ejecutar Minimarket
#
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales en .env
#   3. Asegúrate de que .env está en .gitignore (NUNCA commitear credenciales)
# ─────────────────────────────────────────────────────────────────────────────

# ── Oracle DB en AWS RDS ──────────────────────────────────────────────────────
# Endpoint del host RDS (sin puerto ni service name)
# Ejemplo: minimarket-db.cxyz1234abcd.us-east-1.rds.amazonaws.com
AWS_RDS_ENDPOINT=your-rds-endpoint.rds.amazonaws.com

# Nombre del servicio Oracle (SID o Service Name configurado en RDS)
# Ejemplo: ORCL  o  MINIMARKETDB
DB_SERVICE_NAME=ORCL

# Usuario de la base de datos (principio de menor privilegio:
# usar un usuario específico de la app, NO el usuario administrador SYS/SYSTEM)
DB_USERNAME=minimarket_app

# Contraseña del usuario de la base de datos
DB_PASSWORD=change_me_strong_password

# ── (Opcional) Puerto Oracle — por defecto 1521 ───────────────────────────────
# Si tu RDS usa un puerto distinto al estándar, ajusta el datasource.url en
# application.properties: jdbc:oracle:thin:@${AWS_RDS_ENDPOINT}:${DB_PORT}/${DB_SERVICE_NAME}
# DB_PORT=1521

# ── (Opcional) Perfil de Spring activo ───────────────────────────────────────
# Valores posibles: dev | test | prod
# SPRING_PROFILES_ACTIVE=prod
